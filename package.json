{
    "name": "node-disguise",
    "version": "1.0.0",
    "description": "Native Node.js/TypeScript client for Disguise Designer plugins",
    "author": {
        "name": "ON LX Limited"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "format": "prettier --write src tests scripts *.json",
        "format:check": "prettier --check src tests scripts *.json",
        "check": "npm run format:check && npm run build && npm test",
        "upstream:check": "node scripts/check-upstream.mjs"
    },
    "dependencies": {
        "bonjour-service": "^1.2.1"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.15",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    },
    "license": "MIT",
    "packageManager": "yarn@4.18.0"
}
